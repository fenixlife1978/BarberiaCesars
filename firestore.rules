rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /users/{userId} {
      // Users can read/write their own data. Super admins can read/write any user's data.
      allow read, write: if request.auth.uid == userId || isSuperAdmin();
    }
    
    match /users/{userId}/{document=**} {
        // Users can manage their own subcollections. Super admins can manage any.
        allow read, write, create, delete: if request.auth.uid == userId || isSuperAdmin();
    }
  }
}
