rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'super_admin';
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Settings for the default user (company logo/name) can be read by any authenticated user
    match /users/default-user/settings/general {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin(request.auth.uid); // Only super admin can change global settings
    }

    match /users/{userId} {
      // Users can read their own profile.
      // SuperAdmins can read any profile.
      allow read: if request.auth.uid == userId || isSuperAdmin(request.auth.uid);
      
      // Users can create their own profile document.
      // SuperAdmins can write to any profile.
      allow write: if request.auth.uid == userId || isSuperAdmin(request.auth.uid);
    }
    
    // This rule covers all subcollections for a user (taxRecords, economicLicenses, operatingExpenses, settings)
    match /users/{userId}/{document=**} {
        // Users can manage their own subcollection documents.
        // SuperAdmins can manage any user's subcollection documents.
        allow read, write, create, delete: if request.auth.uid == userId || isSuperAdmin(request.auth.uid);
    }
  }
}
