rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read and write their own user document.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Users can read and write to their own settings subcollection.
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Users can read and write to any other subcollection under their own user document.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth.uid == userId;
    }

    // A special rule to allow any authenticated user to read the default user's settings,
    // which is used for public branding info like the logo on the login page.
    match /users/default-user/settings/general {
      allow get: if request.auth != null;
    }
  }
}
