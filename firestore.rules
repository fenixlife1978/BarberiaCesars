rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Function to check if the user has the 'super_admin' custom claim
    function isSuperAdmin() {
      return request.auth.token.role == 'super_admin';
    }

    // Rule for user documents
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
    
    // Rule for the general settings of the default user (e.g., logo on login page)
    match /users/default-user/settings/general {
      allow get: if request.auth != null; // Any authenticated user can read branding
      allow write: if isSuperAdmin(); // Only super admins can change branding
    }
    
    // Rule for any user's settings
    match /users/{userId}/settings/{settingId} {
       allow read, write: if isOwner(userId) || isSuperAdmin();
    }
    
    // Rule for all other subcollections (taxRecords, operatingExpenses, etc.)
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
