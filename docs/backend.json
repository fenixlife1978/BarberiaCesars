{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "description": "Represents a user account in the application.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user, matching the Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        }
      },
      "required": ["id", "email"]
    },
    "TaxRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TaxRecord",
      "type": "object",
      "description": "Represents a tax payment record.",
      "properties": {
        "id": { "type": "string" },
        "paymentDate": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "amountBolivares": { "type": "number" },
        "bcvRate": { "type": "number" },
        "amountEuros": { "type": "number" },
        "settledMonths": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "userId": { "type": "string", "description": "The UID of the user who owns this record." }
      },
      "required": ["id", "paymentDate", "description", "receiptNumber", "amountBolivares", "bcvRate", "amountEuros", "settledMonths", "userId"]
    },
    "EconomicLicense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EconomicLicense",
      "type": "object",
      "description": "Represents an economic activity license.",
      "properties": {
        "id": { "type": "string" },
        "taxpayerId": { "type": "string" },
        "taxpayerName": { "type": "string" },
        "capital": { "type": "number" },
        "fiscalAddress": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "expirationDate": { "type": "string", "format": "date" },
        "userId": { "type": "string", "description": "The UID of the user who owns this license." }
      },
      "required": ["id", "taxpayerId", "taxpayerName", "capital", "fiscalAddress", "licenseNumber", "issueDate", "expirationDate", "userId"]
    },
    "Settings": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Settings",
        "description": "Represents user-specific settings.",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "logoUrl": { "type": "string", "format": "uri" },
            "userId": { "type": "string" }
        },
        "required": ["id", "userId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores public profile information for a user."
        }
      },
      {
        "path": "/users/{userId}/taxRecords/{taxRecordId}",
        "definition": {
          "entityName": "TaxRecord",
          "schema": { "$ref": "#/entities/TaxRecord" },
          "description": "Stores tax payment records for a specific user."
        }
      },
      {
        "path": "/users/{userId}/economicLicenses/{licenseId}",
        "definition": {
          "entityName": "EconomicLicense",
          "schema": { "$ref": "#/entities/EconomicLicense" },
          "description": "Stores economic licenses for a specific user."
        }
      },
      {
        "path": "/users/{userId}/settings/general",
        "definition": {
            "entityName": "Settings",
            "schema": { "$ref": "#/entities/Settings" },
            "description": "Stores general settings for a specific user."
        }
      }
    ]
  }
}
